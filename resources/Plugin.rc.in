      VALUE "FileDescription", "Illustrator Table Tool (development build)\0"
      VALUE "FileVersion", "0.1.0\0"
      VALUE "ProductName", "Illustrator Table Tool\0"
      VALUE "InternalName", "IllustratorTableTool\0"
    END
  END
  BLOCK "VarFileInfo"
