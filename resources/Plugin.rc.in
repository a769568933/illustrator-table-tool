#include <windows.h>
#pragma code_page(65001)
plugin pipl "@PIPL_OUTPUT@"
16001 svg "@PROJECT_SOURCE_DIR@/resources/Tool.svg"
20001 DIALOGEX 0,0,260,151
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新建表格"
FONT 9,"Microsoft YaHei UI"
BEGIN
  LTEXT "行数（1–100）",-1,12,16,92,13
  EDITTEXT 20101,116,13,126,15,ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "列数（1–50）",-1,12,41,92,13
  EDITTEXT 20102,116,38,126,15,ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "总宽度（毫米）",-1,12,66,92,13
  EDITTEXT 20103,116,63,126,15,ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "总高度（毫米）",-1,12,91,92,13
  EDITTEXT 20104,116,88,126,15,ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "确定后，在画布单击放置表格。",-1,12,113,230,12
  DEFPUSHBUTTON "确定",IDOK,130,131,53,15,WS_TABSTOP
  PUSHBUTTON "取消",IDCANCEL,189,131,53,15,WS_TABSTOP
END
20002 DIALOGEX 0,0,300,314
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "单元格样式"
FONT 9,"Microsoft YaHei UI"
BEGIN
  LTEXT "字体",-1,12,16,90,13
  COMBOBOX 20204,108,13,178,140,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "字号（点）",-1,12,42,90,13
  EDITTEXT 20201,108,39,178,15,ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "水平对齐",-1,12,68,90,13
  COMBOBOX 20205,108,65,178,65,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "垂直对齐",-1,12,94,90,13
  COMBOBOX 20209,108,91,178,65,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "文字颜色",-1,12,120,90,13
  PUSHBUTTON "选择…",20208,108,117,178,17,WS_TABSTOP
  LTEXT "单元格底色",-1,12,146,90,13
  PUSHBUTTON "选择…",20206,108,143,178,17,WS_TABSTOP
  AUTOCHECKBOX "透明背景（无填充）",20210,108,165,178,17,WS_TABSTOP
  LTEXT "边框颜色",-1,12,191,90,13
  PUSHBUTTON "选择…",20207,108,188,178,17,WS_TABSTOP
  LTEXT "边框粗细（点）",-1,12,217,90,13
  EDITTEXT 20202,108,214,178,15,ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "四周内边距（毫米）",-1,12,243,95,13
  EDITTEXT 20203,108,240,178,15,ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "相邻边框采用最近设置的样式。",-1,12,270,276,13
  DEFPUSHBUTTON "应用",IDOK,174,292,53,15,WS_TABSTOP
  PUSHBUTTON "取消",IDCANCEL,233,292,53,15,WS_TABSTOP
END
1 VERSIONINFO
FILEVERSION 0,2,4,0
PRODUCTVERSION 0,2,4,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Illustrator Table Tool (local test build)\0"
      VALUE "FileVersion", "0.2.4\0"
      VALUE "ProductName", "Illustrator Table Tool\0"
      VALUE "InternalName", "IllustratorTableTool\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
